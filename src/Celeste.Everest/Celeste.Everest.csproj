<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <LangVersion>12.0</LangVersion>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <AssemblyName>Celeste.Everest</AssemblyName>
        <RootNamespace>Celeste.Everest</RootNamespace>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <DefineConstants>$(DefineConstants);JETBRAINS_ANNOTATIONS</DefineConstants>
        <CelesteRuntimeIdentifier
            Condition="'$(CelesteRuntimeIdentifier)' == ''"
        >$(NETCoreSdkRuntimeIdentifier)</CelesteRuntimeIdentifier>
        <CelesteLuaLibraryName Condition="'$(CelesteRuntimeIdentifier)' == 'win-x64'">lua54.dll</CelesteLuaLibraryName>
        <CelesteLuaLibraryName
            Condition="'$(CelesteRuntimeIdentifier)' == 'linux-x64'"
        >liblua54.so</CelesteLuaLibraryName>
        <CelesteLuaLibraryName
            Condition="'$(CelesteRuntimeIdentifier)' == 'osx-x64'"
        >liblua54.dylib</CelesteLuaLibraryName>
        <CelesteLuaOutputDirectory>$(CelesteRuntimeIdentifier)</CelesteLuaOutputDirectory>
        <CelesteLuaOutputDirectory
            Condition="'$(CelesteRuntimeIdentifier)' == 'win-x64'"
        >x86_64</CelesteLuaOutputDirectory>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="../Celeste.Core/Celeste.Core.csproj" />
        <ProjectReference Include="../Celeste.Input.Gameplay/Celeste.Input.Gameplay.csproj" />
        <ProjectReference Include="../Celeste.Physics/Celeste.Physics.csproj" />
        <ProjectReference Include="../Celeste.Formats.Graphics/Celeste.Formats.Graphics.csproj" />
        <ProjectReference Include="../Celeste.Scene/Celeste.Scene.csproj" />
        <ProjectReference Include="../Celeste.Localization/Celeste.Localization.csproj" />
        <ProjectReference Include="../Celeste.Input/Celeste.Input.csproj" />
        <ProjectReference Include="../Celeste.Simulation/Celeste.Simulation.csproj" />
        <ProjectReference Include="../Celeste.Formats.Map/Celeste.Formats.Map.csproj" />
        <ProjectReference Include="../Celeste.Formats.Save/Celeste.Formats.Save.csproj" />
        <ProjectReference Include="../Celeste.Game/Celeste.Game.csproj" />
        <PackageReference Include="JetBrains.Annotations" Version="2023.3.0" />
        <PackageReference Include="Mono.Cecil" Version="$(MonoCecilVersion)" />
        <PackageReference Include="MonoMod.Backports" Version="$(MonoModBackportsVersion)" Aliases="MonoModBackports" />
        <PackageReference Include="MonoMod.Core" Version="$(MonoModCoreVersion)" />
        <PackageReference Include="MonoMod.RuntimeDetour" Version="$(MonoModRuntimeDetourVersion)" />
        <ProjectReference Include="../../vendor/MonoMod/src/MonoMod.Utils/MonoMod.Utils.csproj" />
        <Reference Include="Newtonsoft.Json">
            <HintPath>../../lib/Everest/Newtonsoft.Json.dll</HintPath>
        </Reference>
        <Reference Include="Jdenticon">
            <HintPath>../../lib/Everest/Jdenticon.dll</HintPath>
        </Reference>
        <Reference Include="System.Runtime.CompilerServices.Unsafe">
            <HintPath>../../lib/Metadata/System.Runtime.CompilerServices.Unsafe.dll</HintPath>
        </Reference>
        <Reference Include="System.Reflection.Metadata">
            <HintPath>../../lib/Metadata/System.Reflection.Metadata.dll</HintPath>
        </Reference>
        <Reference Include="System.Collections.Immutable">
            <HintPath>../../lib/Metadata/System.Collections.Immutable.dll</HintPath>
        </Reference>
        <Reference Include="YamlDotNet">
            <HintPath>../../lib/Everest/YamlDotNet.dll</HintPath>
        </Reference>
        <Reference Include="MAB.DotIgnore">
            <HintPath>../../lib/Everest/MAB.DotIgnore.dll</HintPath>
        </Reference>
        <Reference Include="NLua">
            <HintPath>../../lib/Lua/NLua.dll</HintPath>
        </Reference>
        <Reference Include="KeraLua">
            <HintPath>../../lib/Lua/KeraLua.dll</HintPath>
        </Reference>
        <None
            Include="../../lib/Native/$(CelesteRuntimeIdentifier)/$(CelesteLuaLibraryName)"
            Condition="'$(CelesteLuaLibraryName)' != '' And Exists('../../lib/Native/$(CelesteRuntimeIdentifier)/$(CelesteLuaLibraryName)')"
            Link="Native/$(CelesteLuaOutputDirectory)/$(CelesteLuaLibraryName)"
            CopyToOutputDirectory="PreserveNewest"
        />
        <ProjectReference Include="../Celeste.Graphics/Celeste.Graphics.csproj" />
    </ItemGroup>
